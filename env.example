# Required secrets
BOT_TOKEN=123456789:replace_with_botfather_token
OMDB_API_KEY=replace_with_omdb_api_key
OPENAI_API_KEY=replace_with_openai_api_key

# Comma-separated numeric Telegram user IDs permitted to run the workflow
ADMIN_IDS=123456789

# Channel usernames or numeric IDs. The bot must be an administrator in all three.
MAIN_CHANNEL_ID=@nightflixmyanmar
CLUB_CHANNEL_ID=@nightflixclub
DRIVE_CHANNEL_ID=@nightflixdrive

# Optional branding and model settings
DIGITAL_SHOP_LINK=https://example.com/your-digital-shop
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint; leave the default for api.openai.com
OPENAI_API_BASE=https://api.openai.com/v1
LOG_LEVEL=INFO

# Render sets PORT and RENDER_EXTERNAL_URL automatically. Set a random secret for webhook verification.
WEBHOOK_SECRET=replace_with_a_long_random_string
# Optional custom path; do not include a leading slash.
WEBHOOK_PATH=telegram-webhook
